# ─────────────────────────────────────────────────────────────────────────────
# Background job worker - production secrets
#
# Copy to `.env.production` and fill in. That file is gitignored and is uploaded
# by `pnpm release`:
#
#     wrangler deploy --secrets-file .env.production
#
# `--secrets-file` is ADDITIVE: a secret already on the Worker but missing from
# this file is left alone, not deleted. The trap is the opposite one - a key
# present here with an EMPTY value overwrites the live secret with an empty
# string. Delete the line rather than blanking it.
#
# Non-secret config (NODE_ENV) lives in wrangler.jsonc under "vars", not here.
# ─────────────────────────────────────────────────────────────────────────────

# Neon Postgres. Every job writes its status/progress here, and most of them
# write their real output here too.
DATABASE_URL=""

# OpenAI. Used by project generation, sprint generation, quiz generation,
# standup extraction, mock-interview scoring and Pathfinder verification.
OPENAI_API_KEY=""

# Shared HMAC secret. MUST be byte-identical to the value in apps/main and
# apps/uni, or every dispatch is rejected 401: the app signs the job token with
# it and the worker verifies the signature.
WORKER_SECRET=""

# OpenAI Assistant used for Pathfinder verification generation (`asst_…`).
# Read from the WORKER's env, not the app's. Without it every verification job
# fails (refunding correctly, but failing).
PATHFINDER_ASSISTANT_ID=""

# ElevenLabs. The two voice jobs (mock interview transcript, daily standup) poll
# the conversations API for the transcript after the call ends. Without it both
# jobs fail with "Voice processing is not configured".
ELEVENLABS_API_KEY=""
