# ─────────────────────────────────────────────────────────────────────────────
# apps/admin — ShipItHQ internal admin console (admin.shipithq.com)  ·  port 3003
# Copy to `.env` and fill real values. DB + auth secrets must match the other apps.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV="development"

# ── App / cross-app URLs ─────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3003"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3003"

# ── Database (shared @repo/db) ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Auth (shared @repo/auth) ─────────────────────────────────────────────────
BETTER_AUTH_URL="http://localhost:3003"
BETTER_AUTH_SECRET="generate-a-long-random-string"
AUTH_COOKIE_DOMAIN=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_SECRET_ID=""

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_MAIL="ShipItHQ Admin <noreply@shipithq.com>"

# ── Storage (Cloudinary) ─────────────────────────────────────────────────────
